{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unir.edu.es/tfm/scouting_dss/data_contract_schema.json",
  "title": "PlayerPerformanceAndCostRecordContract",
  "description": "Contrato de datos formal para validación en IngestionGate de registros híbridos deportivos (API-Football v3) y financieros (Capology/Transfermarkt).",
  "type": "object",
  "required": [
    "player_id",
    "player_name",
    "birth_year",
    "nationality",
    "club_name",
    "league_id",
    "league_name",
    "season",
    "position_group",
    "minutes_played",
    "appearances",
    "team_possession_pct",
    "goals",
    "assists",
    "expected_goals_xg",
    "expected_assists_xa",
    "key_passes",
    "progressive_passes",
    "progressive_carries",
    "successful_dribbles",
    "shots_on_target",
    "tackles",
    "interceptions",
    "duels_won",
    "aerial_duels_won",
    "blocks",
    "recoveries",
    "market_value_eur",
    "annual_gross_salary_eur",
    "fuzzy_match_score"
  ],
  "properties": {
    "player_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Identificador único inmutable del jugador en API-Football v3."
    },
    "player_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120,
      "description": "Nombre completo normalizado del futbolista."
    },
    "birth_year": {
      "type": "integer",
      "minimum": 1975,
      "maximum": 2010,
      "description": "Año de nacimiento para control de cohorte etaria y desambiguación."
    },
    "nationality": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "club_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "league_id": {
      "type": "integer",
      "enum": [39, 61, 78, 88, 94, 135, 140],
      "description": "ID oficial de liga autorizada en el alcance del estudio."
    },
    "league_name": {
      "type": "string",
      "minLength": 2
    },
    "season": {
      "type": "integer",
      "minimum": 2020,
      "maximum": 2030
    },
    "season_snapshot": {
      "type": "string",
      "minLength": 4,
      "maxLength": 40,
      "description": "Ventana temporal estática (Point-in-Time Snapshot) en la que se registraron los minutos, club y valoración del jugador (ej. '2023/24 - 2024/25')."
    },
    "position_group": {
      "type": "string",
      "enum": ["GK", "DF", "MF", "FW"],
      "description": "Macro-posición táctica estandarizada: Goalkeeper, Defender, Midfielder, Forward."
    },
    "minutes_played": {
      "type": "number",
      "minimum": 0,
      "maximum": 6000,
      "description": "Minutos totales disputados en competición oficial durante la temporada."
    },
    "appearances": {
      "type": "integer",
      "minimum": 1,
      "maximum": 75
    },
    "team_possession_pct": {
      "type": "number",
      "minimum": 25.0,
      "maximum": 80.0,
      "description": "Porcentaje medio de posesión de balón del club de origen [25%, 80%]."
    },
    "goals": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "assists": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "expected_goals_xg": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "expected_assists_xa": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "key_passes": {
      "type": "number",
      "minimum": 0
    },
    "progressive_passes": {
      "type": "number",
      "minimum": 0
    },
    "progressive_carries": {
      "type": "number",
      "minimum": 0
    },
    "successful_dribbles": {
      "type": "number",
      "minimum": 0
    },
    "shots_on_target": {
      "type": "number",
      "minimum": 0
    },
    "tackles": {
      "type": "number",
      "minimum": 0
    },
    "interceptions": {
      "type": "number",
      "minimum": 0
    },
    "duels_won": {
      "type": "number",
      "minimum": 0
    },
    "aerial_duels_won": {
      "type": "number",
      "minimum": 0
    },
    "blocks": {
      "type": "number",
      "minimum": 0
    },
    "recoveries": {
      "type": "number",
      "minimum": 0
    },
    "market_value_eur": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 300000000,
      "description": "Valor de mercado estimado en Euros (> 0 EUR)."
    },
    "annual_gross_salary_eur": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 150000000,
      "description": "Salario bruto anual en Euros procedente de Capology (> 0 EUR)."
    },
    "contract_expiration_year": {
      "type": ["integer", "null"],
      "minimum": 2024,
      "maximum": 2035
    },
    "fuzzy_match_score": {
      "type": "number",
      "minimum": 0.85,
      "maximum": 1.0,
      "description": "Similitud de Levenshtein normalizada alcanzada en el cruce de entidades."
    }
  },
  "additionalProperties": true
}
