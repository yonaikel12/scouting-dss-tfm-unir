# ==============================================================================
# VARIABLES DE ENTORNO - PROTOTIPO SCOUTING DSS (TFM UNIR)
# ==============================================================================
# Copiar este archivo a `.env` y completar con credenciales reales.
# Ninguna credencial debe ser versionada en Git (Cumplimiento RGPD Art. 32).

# --- API-Football REST v3 (RapidAPI / API-Sports) ---
API_FOOTBALL_KEY=tu_clave_secreta_api_football_aqui
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- Persistencia NoSQL Capa Bronze (MongoDB) ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=scouting_dss_bronze
MONGO_COLLECTION_PLAYERS=raw_api_football_players
MONGO_COLLECTION_FINANCIALS=raw_financial_records
MONGO_COLLECTION_AUDIT=ingestion_audit_logs

# --- Almacenamiento Analítico Capa Silver/Gold (DuckDB & Parquet) ---
DUCKDB_DATABASE_PATH=data/processed/scouting_gold.duckdb
SILVER_PARQUET_PATH=data/interim/players_silver.parquet
GOLD_PARQUET_PATH=data/processed/players_gold_analytics.parquet

# --- Entorno de Ejecución ---
ENVIRONMENT=development
LOG_LEVEL=INFO
RANDOM_SEED=42
